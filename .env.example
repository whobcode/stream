# Cloudflare Workers Environment Variables Example
# Copy this file to .env and fill in your values
# Note: Secrets should be set using `wrangler secret put` command

# NVR Configuration (public vars in wrangler.jsonc)
NVR_HOST=hwmnbn.myddns.me:8080
NVR_USERNAME=hwmnbn

# Secrets (set using: wrangler secret put SECRET_NAME)
# DO NOT commit these values to git!

# NVR_PASSWORD=@codecam22
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# KV Namespace IDs (update in wrangler.jsonc after creation)
# Create with: wrangler kv:namespace create STREAM_CACHE
# STREAM_CACHE_ID=your_production_kv_id
# STREAM_CACHE_PREVIEW_ID=your_preview_kv_id
