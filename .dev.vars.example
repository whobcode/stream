# Copy to `.dev.vars` for local `wrangler dev` (.dev.vars is gitignored; this template is safe to commit).
# Production secrets are set with: wrangler secret put <NAME>

# NVR login password (ROTATE the value that was previously committed in .env.example!)
NVR_PASSWORD=changeme

# Only required if the worker calls the Cloudflare Stream REST API
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_stream_scoped_api_token
